# ============================================================================
# apsilva-bed-data-platform/.env.example
# ----------------------------------------------------------------------------
# Modelo de configuracao do backend FastAPI.
# Copie para .env e ajuste os valores conforme o ambiente.
#
#   cp .env.example .env
#
# Regras gerais:
# - Nao commitar credenciais reais no git.
# - Em ambiente local com docker compose, os defaults abaixo funcionam.
# ============================================================================

# ============================================================================
# [APP CORE] - OBRIGATORIO
# ----------------------------------------------------------------------------
# PROJECT_HOST: host publico usado em docs/links locais.
PROJECT_HOST=apsilva-bed-data-platform.localhost

# PROJECT_PORT: porta HTTP da API FastAPI no host.
PROJECT_PORT=8000

# APP_ENV: nome do ambiente de execucao (ex.: docker, dev, staging, prod).
APP_ENV=docker

# LOG_LEVEL: nivel de log da aplicacao (debug, info, warning, error).
LOG_LEVEL=info

# ============================================================================
# [SECRETS] - OBRIGATORIO
# ----------------------------------------------------------------------------
# SECRET_BACKEND:
# - env   -> le tokens diretamente deste arquivo .env
# - vault -> le tokens no Vault (com configuracao abaixo)
SECRET_BACKEND=env

# Vault (usado quando SECRET_BACKEND=vault)
VAULT_ADDR=http://vault:8200
VAULT_TOKEN=dev-root-token
VAULT_KV_MOUNT=secret
VAULT_SECRET_VALUE_KEY=value

# Nome da chave no Vault para token Databricks (quando SECRET_BACKEND=vault)
DATABRICKS_TOKEN_SECRET_NAME=databricks_token

# ============================================================================
# [CORS] - OBRIGATORIO
# ----------------------------------------------------------------------------
# Lista separada por virgula de origens permitidas para o frontend.
# Exemplo local recomendado:
# - http://localhost:8080
# - http://127.0.0.1:8080
# - http://apsilva-fed-data-platform.localhost:8080
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://apsilva-fed-data-platform.localhost:8080

# ============================================================================
# [POSTGRES] - OBRIGATORIO
# ----------------------------------------------------------------------------
# Banco usado para historico de upload e execucao de jobs.
POSTGRES_DB=platform
POSTGRES_USER=platform
POSTGRES_PASSWORD=platform

# DATABASE_URL deve apontar para o service "postgres" da rede docker local.
# Formato: postgresql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql://platform:platform@postgres:5432/platform

# ============================================================================
# [DATA INGESTION POLICY] - OBRIGATORIO
# ----------------------------------------------------------------------------
# Politica de seguranca para limitar upload somente a schema/volume permitidos.
DATA_INGESTION_ALLOWED_SCHEMA=ingestion
DATA_INGESTION_ALLOWED_VOLUME=raw

# Limite maximo de upload por arquivo, em MB (inteiro > 0).
DATA_INGESTION_MAX_UPLOAD_MB=15

# ============================================================================
# [DATABRICKS] - OBRIGATORIO PARA INTEGRACAO REAL
# ----------------------------------------------------------------------------
# DATABRICKS_WORKSPACE_NAME: nome logico do workspace (para identificacao).
DATABRICKS_WORKSPACE_NAME=

# DATABRICKS_WORKSPACE: URL base do workspace (ex.: https://dbc-xxxx.cloud.databricks.com/)
DATABRICKS_WORKSPACE=

# DATABRICKS_TOKEN:
# - Preencha quando SECRET_BACKEND=env
# - Deixe vazio quando SECRET_BACKEND=vault (token vem do Vault)
DATABRICKS_TOKEN=
