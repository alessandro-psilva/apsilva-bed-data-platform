PROJECT_HOST=apsilva-bed-data-platform.localhost
PROJECT_PORT=8000
APP_ENV=docker
LOG_LEVEL=info
SECRET_BACKEND=env
VAULT_ADDR=http://vault:8200
VAULT_TOKEN=dev-root-token
VAULT_KV_MOUNT=secret
VAULT_SECRET_VALUE_KEY=value
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://apsilva-fed-data-platform.localhost:8080
POSTGRES_DB=platform
POSTGRES_USER=platform
POSTGRES_PASSWORD=platform
DATABASE_URL=postgresql://platform:platform@postgres:5432/platform
DATA_INGESTION_ALLOWED_SCHEMA=ingestion
DATA_INGESTION_ALLOWED_VOLUME=raw
DATA_INGESTION_MAX_UPLOAD_MB=15

# Databricks Jobs API
DATABRICKS_WORKSPACE_NAME=
DATABRICKS_WORKSPACE=
DATABRICKS_TOKEN=
DATABRICKS_TOKEN_SECRET_NAME=databricks_token
